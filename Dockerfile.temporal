# Separate glibc image: never replaces the existing web/legacy-worker image.
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY tsconfig.json ./
COPY lib ./lib
COPY runtime ./runtime
COPY scripts/build-temporal-worker.mjs scripts/temporal-service.ts ./scripts/
RUN node scripts/build-temporal-worker.mjs

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.worker ./.worker
COPY --from=build /app/pnpm-lock.yaml ./pnpm-lock.yaml
USER node
CMD ["node", ".worker/temporal-service.cjs", "worker"]
