# Separate glibc image: never replaces the existing web/legacy-worker image.
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY tsconfig.json ./
COPY lib ./lib
COPY runtime ./runtime
COPY scripts/build-temporal-worker.mjs scripts/temporal-service.ts ./scripts/
ARG LOOPLABS_WORKER_PROFILE=ack
RUN node scripts/build-temporal-worker.mjs "$LOOPLABS_WORKER_PROFILE"

FROM node:22-bookworm-slim AS runtime-common
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.worker ./.worker
COPY --from=build /app/pnpm-lock.yaml ./pnpm-lock.yaml
USER node
# Quote is opt-in: build with --target quote-runtime and
# --build-arg LOOPLABS_WORKER_PROFILE=quote. The constant command selects
# the same existing launcher with its explicit profile, never an env selector.
FROM runtime-common AS quote-runtime
RUN test -f .worker/quote-temporal-manifest.json && test -f .worker/quote-temporal-service.cjs && test -f .worker/quote-temporal-workflow.cjs
CMD ["node", ".worker/quote-temporal-service.cjs", "worker", "quote"]

# Keep the default final ACK target and its command unchanged.
FROM runtime-common AS runner
RUN test -f .worker/temporal-manifest.json && test -f .worker/temporal-service.cjs && test -f .worker/temporal-workflow.cjs
CMD ["node", ".worker/temporal-service.cjs", "worker"]
