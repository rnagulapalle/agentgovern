{
  "name": "looplabs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev -p 3007",
    "build": "next build",
    "start": "next start -p 3007",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:repo": "node scripts/check-repository.mjs",
    "check:links": "node scripts/check-links.mjs",
    "quality": "bash scripts/quality-gate.sh",
    "release:check": "bash scripts/release-gate.sh",
    "durable:setup": "tsx --env-file=.env.local scripts/durable-setup.ts",
    "durable:worker": "tsx --env-file=.env.local scripts/durable-worker.ts",
    "durable:agent": "tsx --env-file=.env.local scripts/durable-agent.ts",
    "durable:runtime-role": "tsx --env-file=.env.local scripts/durable-runtime-role.ts",
    "refund:setup": "tsx --env-file=.env.local scripts/refund-setup.ts",
    "refund:twin": "bash scripts/refund-twin.sh",
    "refund:proof": "tsx --env-file=.env.local scripts/refund-proof.ts",
    "workspace:setup": "tsx --env-file=.env.local scripts/workspace-setup.ts",
    "connectors:setup": "tsx --env-file=.env.local scripts/connector-setup.ts",
    "connectors:twin": "bash scripts/connector-twin.sh",
    "connectors:proof": "tsx --env-file=.env.local scripts/connector-proof.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^0.471.1",
    "next": "15.5.26",
    "pg": "^8.23.1",
    "posthog-js": "^1.435.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
