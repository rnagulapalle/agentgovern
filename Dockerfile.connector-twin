# Explicit named build context: FetchSandbox backend source, never its .env,
# private stores, dependency runtime or Docker socket. Private fixture only.
FROM python:3.12-slim
WORKDIR /app
COPY scripts/connector-twin-requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY --from=fetchsandbox app /app/backend/app
COPY --from=fetchsandbox configs/hubspot /app/backend/configs/hubspot
COPY --from=fetchsandbox configs/resend /app/backend/configs/resend
COPY --from=fetchsandbox specs/hubspot /app/backend/specs/hubspot
COPY --from=fetchsandbox specs/resend /app/backend/specs/resend
COPY scripts/connector-twin.py /app/scripts/connector-twin.py
RUN useradd --uid 1000 --no-create-home fixture
ENV FETCHSANDBOX_BACKEND_PATH=/app/backend LOOPLABS_CONNECTOR_STATE_DIR=/state LOOPLABS_TWIN_CONTAINER=1 PYTHONDONTWRITEBYTECODE=1
USER fixture
CMD ["python", "/app/scripts/connector-twin.py"]
