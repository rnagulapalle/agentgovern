# Fresh local checkout: pnpm dev:setup, then pnpm dev:local.
# See docs/LOCAL_DEVELOPMENT.md. Do not hand-write or copy a production
# LOOPLABS_TENANT_WEB_CONFIG publication into this file.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ph

# Optional bounded chat planner. Use a dedicated model-only IAM identity.
LOOPLABS_CHAT_MODEL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
